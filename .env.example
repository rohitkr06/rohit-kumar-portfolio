# ── Ask-Me-Anything generation upgrade (all OPTIONAL) ───────────────────────
# The AMA widget works with ZERO env vars: it embeds the visitor's question
# locally with transformers.js and streams back the best-matching resume
# chunk(s) verbatim. That's the "retrieval-only" mode this project ships with.
#
# To upgrade it to a conversational, LLM-composed answer (still grounded only
# in the retrieved chunks — never freeform hallucination), set ONE of the
# keys below. If both are set, Anthropic is preferred.

# Anthropic (Claude) — used via the Vercel AI SDK's @ai-sdk/anthropic
ANTHROPIC_API_KEY=

# OpenAI — used via the Vercel AI SDK's @ai-sdk/openai (fallback if no Anthropic key)
OPENAI_API_KEY=

# Optional: override the site URL used for OpenGraph/canonical tags when
# deployed somewhere other than the default Vercel URL.
NEXT_PUBLIC_SITE_URL=https://rohitkumar.dev
